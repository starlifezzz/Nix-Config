// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=wr_1788788332204125560 @name=QQ
window-rule {
    match app-id="^QQ$"
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 750; }
}

// @id=wr_1788788667858468655 @name=ghostty终端
window-rule {
    match app-id="^com.mitchellh.ghostty$"
    open-floating true
    default-column-display "tabbed"
    draw-border-with-background true
}

// @id=wr_1788788885630274133 @name=dms设置
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
    default-column-width { fixed 850; }
    default-window-height { fixed 1050; }
}

